DJANGO_SECRET_KEY=generate-a-real-random-value-see-README
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave POSTGRES_DB unset to fall back to local SQLite (db.sqlite3).
# Set these to use PostgreSQL instead:
# POSTGRES_DB=nts_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
